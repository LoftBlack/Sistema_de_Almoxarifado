# Copie este arquivo para ".env" e ajuste os valores antes de subir para produção.
# O ".env" NUNCA deve ser versionado (adicione-o ao .gitignore).

# Chave usada para assinar a sessão do Flask. Gere uma aleatória forte, ex:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-bem-grande

# Descomente e configure se for usar PostgreSQL em produção
# (ex: Render, Railway, ElephantSQL). Sem isso, o sistema usa SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Defina como "true" quando o site estiver rodando atrás de HTTPS.
SESSION_COOKIE_SECURE=false
